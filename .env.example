# Обязательно
TELEGRAM_BOT_TOKEN=123456:ABCDEF...        # получить у @BotFather

# Безопасность
# 32-байтовый ключ Fernet в base64. Сгенерировать:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Список Telegram user_id через запятую, которым разрешён доступ. Пусто = всем.
ALLOWED_USER_IDS=

# Список user_id админов (могут перезагружать, чистить чужие данные)
ADMIN_USER_IDS=

# Пути
DATA_DIR=./data
DB_PATH=./data/bot.db
WORKSPACES_DIR=./data/workspaces

# Лимиты sandbox
SANDBOX_TIMEOUT=60
SANDBOX_MAX_OUTPUT=8000
MAX_AGENT_ITERATIONS=20
MAX_HISTORY_MESSAGES=40

# Логирование
LOG_LEVEL=INFO

# --- Только для docker-compose ---
# Абсолютный путь к папке data НА ХОСТЕ. Должен совпадать с тем, куда docker
# смонтирует /app/data. Нужен, чтобы sandbox-контейнеры могли подмонтировать
# рабочую папку пользователя.
# Пример: HOST_DATA_DIR=/srv/telegram-ai-coder-bot/data
HOST_DATA_DIR=

# Параметры sandbox-контейнеров
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_NETWORK=bridge
SANDBOX_MEMORY=1g
SANDBOX_CPUS=1.0
# Установите 1, чтобы принудительно отключить Docker и использовать локальный subprocess.
DISABLE_DOCKER_SANDBOX=
