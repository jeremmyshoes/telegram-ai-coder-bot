# Обязательно
TELEGRAM_BOT_TOKEN=123456:ABCDEF...        # получить у @BotFather

# Безопасность
# 32-байтовый ключ Fernet в base64. Сгенерировать:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Список Telegram user_id через запятую, которым разрешён доступ. Пусто = всем.
ALLOWED_USER_IDS=

# Список user_id админов (могут перезагружать, чистить чужие данные)
ADMIN_USER_IDS=

# Пути
DATA_DIR=./data
DB_PATH=./data/bot.db
WORKSPACES_DIR=./data/workspaces

# Лимиты sandbox
SANDBOX_TIMEOUT=60
SANDBOX_MAX_OUTPUT=8000
MAX_AGENT_ITERATIONS=20
MAX_HISTORY_MESSAGES=40

# Web-поиск.
# По умолчанию используется DuckDuckGo — БЕЗ API-ключей.
#
# Команда /search работает в perplexity-режиме: ищет в интернете, скачивает
# топ-страницы, и синтезирует ответ через OpenAI gpt-5 (или другую модель из
# SEARCH_SYNTH_MODEL). Нужен openai-ключ (берётся из админского /setkey openai).
# Без openai-ключа — используйте /search -raw запрос для сырого списка ссылок.
#
# Опционально можно включить Google Custom Search JSON API — если задать оба
# ключа ниже, /search будет предпочитать Google вместо DuckDuckGo. Бесплатно:
# 100 запросов/сутки.
#   1. API key — https://console.cloud.google.com/apis/credentials → Create credentials → API key.
#      Включить Custom Search API: https://console.cloud.google.com/apis/library/customsearch.googleapis.com
#   2. CSE ID  — https://programmablesearchengine.google.com/ → Create → разрешить «Search the entire web».
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CSE_ID=

# Модель OpenAI для синтеза ответа в perplexity-режиме /search.
# Варианты: gpt-5, gpt-5-mini, gpt-4o, gpt-4o-mini, и т.п.
SEARCH_SYNTH_MODEL=gpt-5

# Логирование
LOG_LEVEL=INFO

# Генерация картинок через /img (OpenAI Images API)
# Доступные модели: dall-e-3, dall-e-2, gpt-image-1
IMAGE_MODEL=dall-e-3
# dall-e-3: 1024x1024 / 1024x1792 / 1792x1024
# dall-e-2: 256x256 / 512x512 / 1024x1024
# gpt-image-1: 1024x1024 / 1024x1536 / 1536x1024 / auto
IMAGE_SIZE=1024x1024
# Качество по умолчанию (если не передан флаг -q):
#   gpt-image-1: low / medium / high / auto
#   dall-e-3:    standard / hd
# Пусто = не передавать (дефолт OpenAI).
IMAGE_QUALITY=

# --- Только для docker-compose ---
# Абсолютный путь к папке data НА ХОСТЕ. Должен совпадать с тем, куда docker
# смонтирует /app/data. Нужен, чтобы sandbox-контейнеры могли подмонтировать
# рабочую папку пользователя.
# Пример: HOST_DATA_DIR=/srv/telegram-ai-coder-bot/data
HOST_DATA_DIR=

# Параметры sandbox-контейнеров
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_NETWORK=bridge
SANDBOX_MEMORY=1g
SANDBOX_CPUS=1.0
# Установите 1, чтобы принудительно отключить Docker и использовать локальный subprocess.
DISABLE_DOCKER_SANDBOX=
